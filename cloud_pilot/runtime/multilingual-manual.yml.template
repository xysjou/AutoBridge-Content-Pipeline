name: AutoBridge multilingual API pilot
on:
  workflow_dispatch:
    inputs:
      mode:
        description: Offline inspection or separately approved real execution
        type: choice
        options: [preflight, account-check, audit, execute]
        default: preflight
permissions:
  contents: read
concurrency:
  group: autobridge-entire-real-pilot-program
  cancel-in-progress: false
jobs:
  trusted:
    permissions:
      contents: write
      pull-requests: write
    uses: xysjou/AutoBridge-Content-Pipeline/.github/workflows/cloud-pilot-trusted.yml@52547c7f5075a667f47ecbf504b532a52e485ace
    with:
      mode: ${{ inputs.mode }}
