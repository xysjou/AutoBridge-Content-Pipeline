        commentAnchor && commentAnchor.addEventListener("click", function () { window._jumpToComm = true; })
        var scrollListener = function () { var doc = document.documentElement; var body = document.body; var scrollTop = doc.scrollTop || body.scrollTop; var windowHeight = doc.clientHeight || body.clientHeight; var scrollHeight = doc.scrollHeight || body.scrollHeight; if (scrollHeight - scrollTop - windowHeight <= 150) { loadComm() } };
        window.addEventListener("scroll", scrollListener);
        scrollListener();
    })
</script>

    <script>
        
        $("#tt").load('https://www.ithome.com/block/tt.html?' + new Date().getTime());
        
        $("#rank").load('//www.ithome.com/block/rank.html');
        
        $("#cat-hot").load('//www.ithome.com/block/cat/192.html');
        if ($("#cat-hot").find("*").length > 0) {
            $("#cat-hot").show();
        }

        
        $(function () {
            if (imageSupportChecker) {
                imageSupportChecker.ready(function () {
                    lazyLoad()
                })
            } else {
                lazyLoad()
            }
            function lazyLoad() {
                $("img.lazy").lazyload();
            }
        });
        
        if ($(".post_content pre").length > 0 && loadFile) {
            loadFile("//img.ithome.com/file/js/prettify/prettify.js", function () {
                $("pre").addClass("prettyprint"); prettyPrint();
            })
        }
    </script>

