  margin-bottom: 8px;
  font-size: 16px;
  line-height: 16px;
  letter-spacing: 0;
  color: #001311;
}
.menu-topbar .left .area .description[data-v-103a9ae8] {
  font-size: 10px;
  line-height: 10px;
  letter-spacing: 0;
  opacity: 0.8;
  transform: scale(0.8333333);
  transform-origin: left;
  color: #001311;
  white-space: nowrap;
}
.menu-topbar .nav[data-v-103a9ae8] {
  flex: 1;
  display: flex;
  align-items: center;
}
.menu-topbar .nav[data-v-103a9ae8] a {
  display: inline-block;
