        &lt;/div&gt;`;
        }
        })()}
        &lt;div class=&#34;cmp-product-listing-card__content&#34;&gt;
            ${(() =&gt; {
            if(hit.producttagtext &amp;&amp; hit.producttagicon) {
            return html`&lt;div class=&#34;cmp-product-listing-card__product-tag&#34;&gt;
                &lt;span class=&#34;carrier-icon-decorative carrier-icon-decorative--${hit.producttagicon}&#34; aria-hidden=&#34;true&#34;&gt;&lt;/span&gt;
                &lt;span class=&#34;cmp-product-listing-card__product-tag-text&#34;&gt;${hit.producttagtext}&lt;/span&gt;
            &lt;/div&gt;`
            } else if (hit.producttagtext) {
                return html`&lt;div class=&#34;cmp-product-listing-card__product-tag&#34;&gt;
                &lt;span class=&#34;cmp-product-listing-card__product-tag-text&#34;&gt;${hit.producttagtext}&lt;/span&gt;
            &lt;/div&gt;`
            }
            })()}
            ${(() =&gt; {
            if(hit.name){
