    <algolia-hits>
        <template is="algolia-hit-template">&lt;div class=&#34;algolia-analytics&#34; data-promoted=&#34;${hit?._rankingInfo?.promoted}&#34; data-insights-query-id=&#34;${hit.__queryID}&#34; data-insights-object-id=&#34;${hit.objectID}&#34; data-insights-position=&#34;${hit.__position}&#34; data-cug=&#34;${hit?.meta?.cug}&#34;&gt;&lt;div class=&#34;cmp-product-listing-card&#34; data-model-number=&#34;${hit.model}&#34;&gt;
    &lt;a href=&#34;${hit.url || &#39;#&#39;}&#34; class=&#34;product-card cmp-product-listing-card__link blue-hover-tooltip&#34;
        data-product-click&gt;
        ${(() =&gt; {
        if (hit.productimage) {
        return html` &lt;div class=&#34;cmp-product-listing-card__image-gradient&#34;&gt;
            &lt;div class=&#34;cmp-product-listing-card__hover&#34;&gt;
                &lt;span class=&#34;carrier-icon carrier-icon--arrow&#34; aria-hidden=&#34;true&#34;&gt;&lt;/span&gt;
            &lt;/div&gt;
            &lt;img src=&#34;${hit.productimage}&#34; alt=&#34;${hit.name}&#34; class=&#34;cmp-product-listing-card__image&#34; /&gt;
        &lt;/div&gt;`;
        }else{
        return html` &lt;div class=&#34;cmp-product-listing-card__image-gradient&#34;&gt;
            &lt;div class=&#34;cmp-product-listing-card__hover&#34;&gt;
                &lt;span class=&#34;carrier-icon carrier-icon--arrow&#34; aria-hidden=&#34;true&#34;&gt;&lt;/span&gt;
            &lt;/div&gt;
            &lt;img src=&#34;#&#34; alt=&#34;${hit.name || &#39;Product Image&#39;}&#34; class=&#34;cmp-product-listing-card__image&#34; /&gt;
        &lt;/div&gt;`;
        }
        })()}
        &lt;div class=&#34;cmp-product-listing-card__content&#34;&gt;
            &lt;p class=&#34;cmp-product-listing-card__title&#34;&gt;${components.Highlight({ attribute: &#34;name&#34;, hit })}&lt;/p&gt;
            &lt;div class=&#34;cmp-product-listing-card__model-rating&#34;&gt;
                &lt;span class=&#34;cmp-product-listing-card__model&#34;&gt;Model No: &lt;span class=&#34;cmp-product-listing-card__model-value&#34;&gt;${components.Highlight({ attribute: &#34;model&#34;, hit })}
 &lt;/span&gt;&lt;/span&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/a&gt;
&lt;/div&gt;&lt;/div&gt;</template>
        <template is="algolia-no-results-template">&lt;div class=&#34;cmp-algolia-no-results&#34;&gt;Sorry there are no matching products results, please try searching for a different term.&lt;/div&gt;</template>
        <template is="algolia-autocomplete-footer-template"></template>
    </algolia-hits>
</algolia-index>
</div>
		
	
	<template is="algolia-no-results-template" class="d-none">
		
	</template>
</algolia-indices>

		<template is="algolia-layout-template">&lt;div class=&#34;global-search-typeahead&#34; data-global-search-typeahead-panel&gt;
  &lt;aside class=&#34;global-search-typeahead__sidebar&#34;&gt;
    &lt;section class=&#34;global-search-typeahead__suggestions&#34;&gt;
      ${querySuggestions}
    &lt;/section&gt;
    &lt;section class=&#34;global-search-typeahead__quick-links&#34;&gt;
      ${plugins.plugin_carrierQuickLinks}
    &lt;/section&gt;
&lt;section class=&#34;global-search-typeahead__see-all-results&#34;&gt;
      ${plugins.plugin_carrierSeeAllResults}
    &lt;/section&gt;
  &lt;/aside&gt;
  &lt;main class=&#34;global-search-typeahead__main&#34;&gt;
    &lt;section class=&#34;global-search-typeahead__results&#34; data-has-results=&#34;${hasResults}&#34;&gt;
      ${sources}
    &lt;/section&gt;
    &lt;nav class=&#34;global-search-typeahead__footer&#34;&gt;
      ${plugins.plugin_carrierFooterLinks}
    &lt;/nav&gt;
  &lt;/main&gt;
&lt;/div&gt;</template>
	</algolia-autocomplete>

	

	
</div>
</div>

    <div class="global-search-typeahead__panel-host" aria-live="polite"></div>
</div>

